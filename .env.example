PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority

# 64+ byte random string — used to sign admin session tokens
JWT_SECRET=change-me

# Seed admin account (created on first boot if no users exist)
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=ChangeMe123!

# Comma-separated list of allowed frontend origins (for CORS).
# Include http://localhost:3000 for local frontend dev.
FRONTEND_ORIGIN=http://localhost:3000
